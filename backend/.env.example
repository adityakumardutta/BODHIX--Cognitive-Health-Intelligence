# ============================================================
# BODHIX Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your production values.
# NEVER commit .env to version control.

# ---- Database (Supabase PostgreSQL — SESSION POOLER) ----
# Fill in your Supabase connection details (values OWN this file, never commit .env).
# Use the SESSION POOLER endpoint, not the direct/db.<ref>.supabase.co host.
#   DB_HOST = <region>.pooler.supabase.com        (e.g. aws-0-us-east-1.pooler.supabase.com)
#   DB_PORT = 5432                                 (session pooler port; 6543 = transaction pooler)
#   DB_NAME = postgres                             (or your database name)
#   DB_USER = <db-user>.<YOUR-PROJECT-REF>         (username MUST include the project-ref suffix)
#   DB_PASSWORD = your-database-role-password
# SSL is enforced (sslmode=require in application.properties) - do not disable.
DB_HOST=your-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-role-password

# ---- JWT Authentication ----
# Generate a strong random string (min 32 chars): openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRATION_MS=28800000

# ---- CORS (Production Frontend Origin) ----
# Replace with your actual Vercel/frontend domain
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# ---- Server Port (Render uses 10000 by default) ----
SERVER_PORT=8080

# ---- Google OAuth (if using server-side Google login) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (SMTP for report delivery) ----
# Example for Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587
# Use App Password for Gmail (not your regular password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@yourdomain.com

# ---- Firebase (for Google sign-in ID token verification) ----
# This is the Firebase project ID (public identifier, not a secret)
FIREBASE_PROJECT_ID=your-firebase-project-id
