# ============================================================
# BODHIX — Frontend environment configuration (PUBLIC values only)
# ============================================================
# Google/Firebase authentication has been removed. Login options are
# email/password and Guest Login (backend-issued JWT via /api/auth/guest).
# No frontend secrets are required; VITE_FIREBASE_* variables are obsolete.

# REST API base URL.
# Local development falls back to http://localhost:8081/api when unset.
# Production (single-deployment) value is committed in .env.production.
VITE_API_URL=https://bodhix-backend.onrender.com/api
