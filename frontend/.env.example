# ============================================================
# BODHIX — Frontend environment configuration (PUBLIC values only)
# ============================================================

# REST API base URL.
# Local development falls back to http://localhost:8081/api when unset.
# Production (Render) value is committed in .env.production and can be
# overridden in Vercel via the VITE_API_URL environment variable.
VITE_API_URL=https://bodhix-backend.onrender.com/api

# ---- Firebase Web config (from Firebase project settings -> General -> Your apps) ----
# These are PUBLIC web identifiers safe for the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
